{
  "name": "@relaton/api",
  "version": "3.0.2",
  "description": "Relaton bibliographic API: a deployable Cloudflare Worker app (REST + GraphQL + MCP + cloud store) and a CLI (init/check/deploy/ingest) serving every relaton-data-* collection.",
  "license": "BSD-2-Clause",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "bin": {
    "relaton-api": "bin/relaton-api.mjs"
  },
  "files": [
    "src",
    "bin",
    "contract",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "graphql-yoga": "^5.21.3",
    "hono": "^4.13.2",
    "js-yaml": "^5.3.0",
    "zod": "^4.4.3",
    "relaton": "^0.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relaton/relaton-api-js.git",
    "directory": "packages/relaton-api"
  },
  "bugs": "https://github.com/relaton/relaton-api-js/issues",
  "homepage": "https://github.com/relaton/relaton-api-js/tree/main/packages/relaton-api",
  "keywords": [
    "relaton",
    "standards",
    "bibliography",
    "metanorma",
    "cloudflare-workers"
  ]
}
